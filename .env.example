# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dnd_sheets"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth (login) — Developer Portal > OAuth2 > General
# Redirect URI to register: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID="your-client-id"
DISCORD_CLIENT_SECRET="your-client-secret"

# Standalone realtime server (server/socket-server.js)
SOCKET_SERVER_PORT=4000
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Same private secret (at least 32 random characters) in Next.js, realtime server and bot.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SOCKET_SERVER_SECRET=""
SOCKET_SERVER_URL="http://localhost:4000"

# Discord bridge (server/discord-bot.js)
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CHANNEL_ID="your-channel-id"

# Quest board -> Discord channel post (reuses DISCORD_BOT_TOKEN above)
DISCORD_QUEST_CHANNEL_ID="channel-id-for-mission-announcements"

# Sessions -> Discord Scheduled Events (reuses DISCORD_BOT_TOKEN above)
DISCORD_GUILD_ID="your-server-id"
NEXT_PUBLIC_DISCORD_GUILD_ID="same-server-id-exposed-to-the-browser-for-event-links"

# Discord role -> site role sync (leave both unset to disable this sync)
DISCORD_ADMIN_ROLE_ID="role-id-of-your-Admin-role"
DISCORD_DM_ROLE_ID="role-id-of-your-DM-role"
